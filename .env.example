# Web server port (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Optional. Used only for AI document/invoice parsing and query generation.
# In Google AI Studio, this is automatically injected.
# When running locally or on external servers, get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Optional for local development. Used for self-referential links or webhooks.
APP_URL="http://localhost:3000"
