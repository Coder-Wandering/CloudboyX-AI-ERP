    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
